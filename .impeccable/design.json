      "css": ".ds-st{display:inline-flex;align-items:center;gap:.45rem;color:#8d939c;white-space:nowrap;margin-right:1rem;font:400 .92rem/1.5 \"Mona Sans\",Arial,sans-serif}.ds-st::before{content:\"\";width:.5rem;height:.5rem;border-radius:50%;background:var(--dot)}.ds-g{--dot:#3fb950}.ds-w{--dot:#e3a008}.ds-r{--dot:#f0645a}"
