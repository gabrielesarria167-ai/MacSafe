      "css": ".ds-bar{display:flex;gap:2px;height:24px;background:#1f1f21;padding:12px;border-radius:11px}.ds-bar i{border-radius:4px;min-width:2px;transform-origin:left center;animation:ds-bar-in 1.1s cubic-bezier(.16,1,.3,1) backwards}.ds-bar i:nth-child(2){animation-delay:.06s}.ds-bar i:nth-child(3){animation-delay:.12s}.ds-bar i:nth-child(4){animation-delay:.18s}.ds-bar i:nth-child(5){animation-delay:.24s}@keyframes ds-bar-in{from{transform:scaleX(.45)}}@media (prefers-reduced-motion:reduce){.ds-bar i{animation:none}}"
