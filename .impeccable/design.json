      "html": "<a class=\"ds-dl\" href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 4v11\"/><path d=\"m7 10.5 5 5 5-5\"/><path d=\"M5 20h14\"/></svg>MacSafe.zip</a>",
      "css": ".ds-dl{display:inline-flex;align-items:center;gap:.5rem;font:500 .88rem/1.4 \"Mona Sans\",\"Helvetica Neue\",Arial,sans-serif;color:#eceef1;text-decoration:none;border:1px solid #22262c;background:#16191d;border-radius:8px;padding:.55rem .9rem}.ds-dl svg{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-dl:hover{border-color:#7c838e}.ds-dl:focus-visible{outline:2px solid #3987e5;outline-offset:3px}"
    },
    {
      "name": "Command Bar",
      "kind": "custom",
      "refersTo": "command-bar",
      "description": "Signature: a pasteable command in Fragment Mono with a $ prompt and Copy button flush right.",
      "html": "<div class=\"ds-cmd\"><pre>curl -fsSL https://<wbr>gabrielesarria167-ai.github.io<wbr>/MacSafe/install.sh | bash</pre><button class=\"ds-cmd-copy\" type=\"button\">Copy</button></div>",
      "css": ".ds-cmd{display:flex;align-items:center;gap:.8rem;max-width:48rem;background:#111316;border:1px solid #22262c;border-radius:10px;padding:.45rem .45rem .45rem 1rem}.ds-cmd pre{flex:1;min-width:0;margin:0;font:400 .82rem/1.5 \"Fragment Mono\",ui-monospace,Menlo,monospace;color:#eceef1;white-space:pre-wrap;overflow-wrap:normal;word-break:normal;padding-block:.35rem}.ds-cmd pre::before{content:\"$ \";color:#7c838e}.ds-cmd-copy{font:500 .82rem/1 \"Mona Sans\",Arial,sans-serif;color:#0a0b0d;background:#eceef1;border:0;border-radius:7px;padding:.55rem .8rem;min-width:5.4rem;cursor:pointer}.ds-cmd-copy:hover{background:#fff}.ds-cmd-copy:focus-visible{outline:2px solid #3987e5;outline-offset:3px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Hairline-underlined bar: mark and name left, muted links right.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-brand\" href=\"#\"><span class=\"ds-mark\"><i></i></span>MacSafe</a><a href=\"#\">App &amp; CLI</a><a href=\"#\">Safety</a><a href=\"#\">Install</a><a href=\"#\">GitHub</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:1.6rem;height:3.6rem;padding-inline:16px;font:400 .88rem/1.4 \"Mona Sans\",Arial,sans-serif;border-bottom:1px solid #22262c;background:#0a0b0d}.ds-nav a{color:#8d939c;text-decoration:none}.ds-nav a:hover{color:#eceef1}.ds-nav a:focus-visible{outline:2px solid #3987e5;outline-offset:3px;border-radius:4px}.ds-nav .ds-brand{color:#eceef1;font-weight:600;font-size:1rem;margin-right:auto;display:flex;align-items:center;gap:.55rem;letter-spacing:-.01em}.ds-mark{width:1.15em;height:1.15em;border-radius:28%;background:linear-gradient(#171c29,#29334a);display:grid;place-items:center}.ds-mark i{width:66%;height:66%;border-radius:50%;background:conic-gradient(#2a78d6 0 20%,#eb6834 0 34%,#1baf7a 0 58%,#eda100 0 76%,rgba(255,255,255,.14) 0);-webkit-mask:radial-gradient(circle,transparent 38%,#000 40%);mask:radial-gradient(circle,transparent 38%,#000 40%)}"
    },
    {
      "name": "Panel Pair",
      "kind": "card",
      "refersTo": "panel",
      "description": "Two panels sharing one hairline border, divided by a hairline.",
      "html": "<div class=\"ds-duo\"><div><h3>Mac app</h3><p>For browsing, sorting and bulk cleanup.</p></div><div><h3><code>macsafe</code></h3><p>A quick check without leaving Terminal.</p></div></div>",
      "css": ".ds-duo{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:1px solid #22262c;border-radius:12px;overflow:hidden;font-family:\"Mona Sans\",Arial,sans-serif}.ds-duo>div{padding:1.6rem;display:grid;gap:.7rem;align-content:start;background:#111316}.ds-duo>div+div{border-left:1px solid #22262c}.ds-duo h3{margin:0;font-size:1.15rem;font-weight:600;letter-spacing:-.02em;font-stretch:106%;color:#eceef1}.ds-duo p{margin:0;color:#8d939c;font-size:.95rem;line-height:1.6}.ds-duo code{font:400 1em \"Fragment Mono\",ui-monospace,monospace}"
